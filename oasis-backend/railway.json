{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm ci && npm run build"
  },
  "deploy": {
    "startCommand": "npm start",
    "preDeployCommand": ["npm run db:init"],
    "healthcheckPath": "/health/live",
    "healthcheckTimeout": 120
  }
}
